# ========================================================
# Shivangi Mobile - Backend Environment Variables (Render)
# ========================================================

# Server Port (Render sets this automatically in production)
PORT=5001
NODE_ENV=production

# MongoDB Database Connection String (MongoDB Atlas)
# ⚠️ Use a least-privilege Atlas user. Rotate if ever committed to git.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shivangi_mobile?retryWrites=true&w=majority

# Cloudinary Storage (For image uploads)
# ⚠️ Keep API_SECRET strictly server-side. Rotate if ever committed to git.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Allowed Frontend URL on Vercel (SEC-007: used for exact CORS allowlist)
FRONTEND_URL=https://shivangi-mobile.vercel.app

# ─── Admin Authentication (SEC-003) ──────────────────────────────────────────
# Admin email for login verification
ADMIN_EMAIL=karangehlot5686@gmail.com

# Generate a bcrypt hash of your admin password and paste here.
# Run once: node -e "import('bcrypt').then(b=>b.default.hash('YOUR_STRONG_PASSWORD',14).then(console.log))"
ADMIN_PASSWORD_HASH=$2b$14$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Strong random string for JWT signing (at least 64 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-64-char-random-hex-string

# =======================================================
# Shivangi Mobile - Environment Configuration
# =======================================================

# --- CLERK AUTHENTICATION (Email OTP) ---
# Create a free application at https://clerk.com
# Then copy your Publishable Key from Dashboard → API Keys
# NEVER use the Secret Key here — secret key is backend-only
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# --- CLOUDINARY (Media Storage) ---
# Cloud name and unsigned preset for direct browser uploads
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Server-side Cloudinary credentials (for backend Express server in server/)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- MONGODB DATABASE ---
# Connection string for your local or MongoDB Atlas cluster
MONGODB_URI=mongodb://127.0.0.1:27017/shivangi_mobile
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shivangi_mobile?retryWrites=true&w=majority

# Backend Server Port
PORT=5000
